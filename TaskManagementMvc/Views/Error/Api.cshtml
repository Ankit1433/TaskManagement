@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">

    <div class="alert alert-danger">

        <h4>
            Error @ViewBag.StatusCode
        </h4>

        <p>
            @ViewBag.Message
        </p>

    </div>

    <a asp-controller="Task"
       asp-action="Index"
       class="btn btn-primary">
        Back to Tasks
    </a>

</div>